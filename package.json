{
  "name": "@aryacode/dsh-plugin-arya-computer-use",
  "version": "1.0.0",
  "description": "Computer use for DSH/AryaCode: agent-desktop UIA engine, agent-browser web lane, takeover UI with a ghost cursor",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./mcp/adapter-server.mjs": "./mcp/adapter-server.mjs",
    "./mcp/settings.mjs": "./mcp/settings.mjs",
    "./mcp/takeover.mjs": "./mcp/takeover.mjs",
    "./mcp/activity.mjs": "./mcp/activity.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "bin": {
    "arya-computer-use-mcp": "./mcp/adapter-server.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "mcp/adapter-server.mjs",
    "mcp/settings.mjs",
    "mcp/takeover.mjs",
    "mcp/activity.mjs",
    "mcp/browser-launcher.mjs",
    "scripts/windows-takeover.ps1",
    "scripts/windows-takeover.cs",
    "scripts/ocr.ps1",
    "skills/arya-desktop/SKILL.md",
    "locale/en.json",
    "icon.svg",
    "LICENSE",
    "NOTICE.md",
    "docs/PLAN.md"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "agent-browser": "0.41.2",
    "agent-desktop": "1.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.1.0-rc.2 || >=0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KonnectSuite/dsh-arya-computer-use.git"
  },
  "homepage": "https://github.com/KonnectSuite/dsh-arya-computer-use#readme",
  "bugs": {
    "url": "https://github.com/KonnectSuite/dsh-arya-computer-use/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "computer-use",
    "agent-desktop",
    "uia",
    "accessibility",
    "agent-browser",
    "windows"
  ],
  "author": "AryaCode",
  "publishConfig": {
    "access": "public"
  }
}
